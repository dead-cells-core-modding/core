<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>DCCMBenchmark</RootNamespace>
    <AssemblyName>DCCMBenchmark</AssemblyName>
    <ModType>library</ModType>
    <NoModCore>true</NoModCore>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(_DCCM_MDK_Root)ref/*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="DeadCellsCoreModding.MDK" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../sources/ModCore/ModCore.csproj" />
    <ProjectReference Include="../../sources/DCCMShell/DCCMShell.csproj" />
    <ProjectReference Include="../../sources/Haxe2CSharp/Haxe2CSharp.csproj" />
    <ProjectReference Include="../../sources/ModCore.Native/ModCore.Native.csproj" />
  </ItemGroup>

</Project>
