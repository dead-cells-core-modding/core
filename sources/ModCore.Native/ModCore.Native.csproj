<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- arm64 reserved for future Android arm64 support.
         When implementing, change PlatformTarget to a conditional based
         on RuntimeIdentifier: x64 for win/linux/android-x64, arm64 for android-arm64. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- Platform-specific defines for native struct layout matching -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="NativeMethods.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModCore.Common\ModCore.Common.csproj" />
    <ProjectReference Include="..\ModCore.Native.Fody\ModCore.Native.Fody.csproj">
      <ExcludeAssets>all</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fody" Version="6.9.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.298">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <WeaverFiles Include="..\..\weaver\netstandard2.0\ModCore.Native.Fody.dll" />
  </ItemGroup>
</Project>
