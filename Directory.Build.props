<Project>
  <PropertyGroup>
    <Version>35.13.2</Version>
    <TargetFramework>net10.0</TargetFramework>
    <RepositoryUrl>https://github.com/dead-cells-core-modding/core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Company>Dead Cells Core Modding</Company>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyDocumentationFilesFromPackages>true</CopyDocumentationFilesFromPackages>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- arm64 is reserved for future Android arm64 support. -->
    <!-- Add it to the Platforms list (AnyCPU;x64;arm64) once the AArch64 -->
    <!-- Native subclass and assembly generators are implemented. -->
    <Platforms>AnyCPU;x64</Platforms>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
    <CETCompat>false</CETCompat>
  </PropertyGroup>

</Project>